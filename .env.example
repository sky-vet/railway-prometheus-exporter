# Railway API Configuration
RAILWAY_API_KEY=your_railway_api_token_here

# Environment Targets (project:environment pairs, comma-separated)
# Format: projectId:environmentId,projectId:environmentId,...
#
# Examples:
# - Monitor production in multiple projects:
#   ENVIRONMENT_TARGETS=proj-a:prod-env,proj-b:prod-env,proj-c:prod-env
#
# - Monitor different environments per project:
#   ENVIRONMENT_TARGETS=proj-a:prod-env,proj-b:staging-env,proj-c:dev-env
#
# - Monitor multiple environments in one project:
#   ENVIRONMENT_TARGETS=proj-a:prod-env,proj-a:staging-env,proj-a:dev-env
ENVIRONMENT_TARGETS=your_project_id:your_environment_id

# Server Configuration
PORT=9090

# Cache Configuration
# Enable/disable caching (default: true)
ENABLE_CACHE=true

# Metrics cache TTL in seconds (default: 30)
# How long to cache actual metric values
METRICS_CACHE_TTL=30

# Discovery cache TTL in seconds (default: 300)
# How long to cache service/environment metadata
DISCOVERY_CACHE_TTL=300

# Optional: Enable debug logging
# DEBUG=true
